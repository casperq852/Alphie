# Required
OPENAI_API_KEY=sk-...

# Optional: web augmentation (https://tavily.com)
TAVILY_API_KEY=

# Models (defaults shown). gpt-5* / o-series reasoning models are supported.
OPENAI_MODEL=gpt-4o-mini
INGEST_MODEL=gpt-4o-mini
# REASONING_EFFORT=low            # minimal | low | medium | high (reasoning models only)

# Storage (defaults to ./data)
# DATA_DIR=/app/data

# Retrieval tuning
# RECENCY_TAU_DAYS=120            # recency decay e-folding time; investment case uses 365
# COMPANY_MATCH_THRESHOLD=0.55    # min similarity to map a name onto a known company
# INGEST_MAX_CHUNKS=160           # max chunks embedded per PDF (0 = no cap)
# EMBED_BATCH_SIZE=64

# Optional Qdrant backend (FAISS is used otherwise)
# USE_QDRANT=true
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=research_chunks

# docker compose: host folder mounted as /app/data
# HOST_DATA_DIR=./data
